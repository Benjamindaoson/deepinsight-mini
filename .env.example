# Environment credentials remain supported. Personal keys are submitted once through Settings and stored server-side with Windows DPAPI; no saved key is returned.
# Load private values into your process environment before starting. This app does not auto-load .env.
MINI_API_KEY=
MINI_BASE_URL=https://api.deepseek.com
MINI_MODEL=deepseek-v4-flash
# Existing LLM_API_KEY / LLM_BASE_URL / LLM_MODEL are fallback names.
MINI_DAILY_REQUESTS=60
MINI_DAILY_TOKENS=180000
# Mandatory for non-loopback access. Set a long random private token and use HTTPS.
MINI_ADMIN_TOKEN=
MINI_PUBLIC_HOST=
MINI_PUBLIC_URL=http://127.0.0.1:8766
# Explicit local fake-IP network tunnel mode. Keep 0 on ordinary networks/VPS.
# Only benchmark DNS ranges, registered HTTPS hosts and verified TLS are accepted.
MINI_TUNNEL_DNS=0
MINI_SMTP_HOST=
MINI_SMTP_PORT=587
MINI_SMTP_FROM=
MINI_SMTP_USER=
MINI_SMTP_PASSWORD=
MINI_TELEGRAM_TOKEN=
MINI_TELEGRAM_CHAT_ID=
MINI_APPRISE_URL=
